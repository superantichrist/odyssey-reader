{
  "schemaVersion": 1,
  "title": "인물과 존재",
  "description": "귀향 서사의 핵심 인물·신·괴물을 첫 등장 또는 대표 장면으로 연결합니다.",
  "entries": [
    {"id":"p-odysseus","nameGreek":"Ὀδυσσεύς","nameKo":"오디세우스","role":"이타케의 왕·귀향자","summary":"트로이아 전쟁 뒤 열 해를 떠돌고 집으로 돌아오는 주인공입니다. 힘보다 지략, 변장, 말과 인내로 위기를 통과합니다.","refs":[{"book":1,"line":57,"label":"칼륍소의 섬에 붙들린 오디세우스"}]},
    {"id":"p-penelope","nameGreek":"Πηνελόπεια","nameKo":"페넬로페","role":"이타케의 왕비","summary":"오디세우스의 아내입니다. 수의 짜기와 침상 시험으로 구혼을 지연하고 남편의 정체를 스스로 검증합니다.","refs":[{"book":1,"line":223,"label":"처음 이름이 언급되는 장면"},{"book":23,"line":173,"label":"침상으로 오디세우스를 시험함"}]},
    {"id":"p-telemachus","nameGreek":"Τηλέμαχος","nameKo":"텔레마코스","role":"오디세우스와 페넬로페의 아들","summary":"아버지의 소식을 찾는 여행을 통해 말하고 결단하는 후계자로 성장하며, 귀환한 아버지와 함께 구혼자들과 싸웁니다.","refs":[{"book":2,"line":194,"label":"회의장에서 조언을 받는 텔레마코스"}]},
    {"id":"p-athena","nameGreek":"Ἀθήνη","nameKo":"아테나","role":"지략과 전쟁의 여신","summary":"오디세우스 가문을 가장 꾸준히 돕는 신입니다. 멘토르를 비롯한 여러 모습으로 변해 계획을 세우고 마지막 평화까지 이끕니다.","refs":[{"book":1,"line":44,"label":"신들의 회의에서 오디세우스를 변호함"},{"book":24,"line":545,"label":"마지막 충돌을 멈춤"}]},
    {"id":"p-zeus","nameGreek":"Ζεύς","nameKo":"제우스","role":"신들과 인간들의 아버지","summary":"신들의 질서를 조정하고 징조와 번개로 결정을 확인합니다. 인간의 방자함과 자초한 파멸을 작품 첫 회의에서 문제 삼습니다.","refs":[{"book":1,"line":28,"label":"신들의 회의를 시작함"},{"book":24,"line":477,"label":"보복을 끝낼 질서를 정함"}]},
    {"id":"p-poseidon","nameGreek":"Ποσειδάων","nameKo":"포세이돈","role":"바다의 신","summary":"아들 폴뤼페모스의 눈을 멀게 한 오디세우스에게 분노해 귀향을 지연시킵니다. 바다 여행의 가장 큰 신적 적대자입니다.","refs":[{"book":1,"line":20,"label":"홀로 오디세우스에게 분노하는 신"}]},
    {"id":"p-calypso","nameGreek":"Καλυψώ","nameKo":"칼륍소","role":"오귀기에의 요정","summary":"오디세우스를 남편으로 삼으려 섬에 붙들고 불멸을 약속하지만, 신들의 명령에 따라 뗏목을 마련해 떠나보냅니다.","refs":[{"book":1,"line":14,"label":"오디세우스를 동굴에 붙듦"}]},
    {"id":"p-hermes","nameGreek":"Ἑρμῆς","nameKo":"헤르메스","role":"신들의 전령·혼의 인도자","summary":"칼륍소에게 석방 명령을 전하고 키르케의 약을 이길 몰뤼를 줍니다. 마지막 권에서는 구혼자들의 혼을 하데스로 인도합니다.","refs":[{"book":1,"line":38,"label":"아이기스토스에게 경고한 전령"},{"book":24,"line":1,"label":"구혼자들의 혼을 이끎"}]},
    {"id":"p-nausicaa","nameGreek":"Ναυσικάα","nameKo":"나우시카아","role":"파이아케스의 공주","summary":"난파한 오디세우스를 두려움 없이 맞아 옷과 길을 알려 주고 왕궁에 접근할 방도를 가르칩니다.","refs":[{"book":6,"line":17,"label":"아테나가 찾아간 나우시카아"}]},
    {"id":"p-alcinous","nameGreek":"Ἀλκίνοος","nameKo":"알키노오스","role":"파이아케스의 왕","summary":"오디세우스를 환대하고 그의 이야기를 들은 뒤, 배와 선물을 마련해 이타케로 돌려보냅니다.","refs":[{"book":6,"line":12,"label":"파이아케스인을 다스리는 왕"}]},
    {"id":"p-arete","nameGreek":"Ἀρήτη","nameKo":"아레테","role":"파이아케스의 왕비","summary":"가문과 백성에게 특별히 존중받는 왕비입니다. 나우시카아는 오디세우스에게 무엇보다 먼저 그녀의 호의를 구하라고 조언합니다.","refs":[{"book":7,"line":54,"label":"아레테의 혈통과 이름"}]},
    {"id":"p-demodocus","nameGreek":"Δημόδοκος","nameKo":"데모도코스","role":"파이아케스의 가객","summary":"눈은 보지 못하지만 무사 여신에게 노래를 받은 가객입니다. 트로이아 전쟁을 노래해 오디세우스의 정체 고백을 이끌어 냅니다.","refs":[{"book":8,"line":44,"label":"노래 재능을 받은 가객"}]},
    {"id":"p-eumaeus","nameGreek":"Εὔμαιος","nameKo":"에우마이오스","role":"오디세우스의 돼지치기·노예","summary":"주인이 없는 동안에도 집을 지킨 충실한 돼지치기입니다. 변장한 오디세우스를 환대하고 구혼자 살해에 함께합니다.","refs":[{"book":14,"line":55,"label":"오디세우스가 직접 말을 거는 돼지치기"}]},
    {"id":"p-philoetius","nameGreek":"Φιλοίτιος","nameKo":"필로이티오스","role":"오디세우스의 소 치는 이·노예","summary":"주인에게 충실한 목자입니다. 오디세우스의 정체를 확인한 뒤 큰방 문을 봉쇄하고 전투에 가담합니다.","refs":[{"book":20,"line":185,"label":"가축을 몰고 큰방에 도착함"}]},
    {"id":"p-eurycleia","nameGreek":"Εὐρύκλεια","nameKo":"에우뤼클레이아","role":"오디세우스 가문의 유모·노예","summary":"오디세우스와 텔레마코스를 길러 낸 늙은 유모입니다. 발을 씻기다 흉터로 주인을 가장 먼저 알아봅니다.","refs":[{"book":1,"line":429,"label":"유모의 이름과 혈통"},{"book":19,"line":467,"label":"흉터를 알아봄"}]},
    {"id":"p-laertes","nameGreek":"Λαέρτης","nameKo":"라에르테스","role":"오디세우스의 아버지","summary":"도시를 떠나 농장에서 상복 같은 옷을 입고 늙어 갑니다. 아들의 흉터와 과수원 기억을 확인하고 마지막 싸움에 나섭니다.","refs":[{"book":1,"line":189,"label":"농장에서 슬퍼하는 라에르테스"},{"book":24,"line":330,"label":"아들의 표지를 확인함"}]},
    {"id":"p-circe","nameGreek":"Κίρκη","nameKo":"키르케","role":"아이아이에의 여신·마술사","summary":"동료들을 돼지로 바꾸지만 헤르메스의 도움을 받은 오디세우스에게 제압됩니다. 이후 저승길과 바다의 위험을 상세히 가르칩니다.","refs":[{"book":8,"line":448,"label":"처음 이름이 예고됨"},{"book":10,"line":210,"label":"동료들에게 약을 먹임"}]},
    {"id":"p-polyphemus","nameGreek":"Πολύφημος","nameKo":"폴뤼페모스","role":"퀴클롭스·포세이돈의 아들","summary":"손님 규범을 거부하고 오디세우스의 동료들을 먹습니다. ‘아무도’라는 이름과 말뚝 계책에 눈을 잃고 아버지에게 저주를 청합니다.","refs":[{"book":1,"line":70,"label":"포세이돈의 아들로 처음 언급됨"},{"book":9,"line":375,"label":"오디세우스가 눈을 공격함"}]},
    {"id":"p-tiresias","nameGreek":"Τειρεσίας","nameKo":"테이레시아스","role":"테바이의 죽은 예언자","summary":"죽은 뒤에도 정신을 보존한 예언자입니다. 저승에서 귀향의 조건과 포세이돈을 달랠 마지막 여정을 알려 줍니다.","refs":[{"book":10,"line":492,"label":"저승에서 신탁을 청할 대상으로 지목됨"},{"book":11,"line":90,"label":"오디세우스에게 예언함"}]},
    {"id":"p-aeolus","nameGreek":"Αἴολος","nameKo":"아이올로스","role":"바람을 관리하는 왕","summary":"바람들을 가죽 부대에 묶어 오디세우스의 귀향을 돕지만, 동료들이 부대를 열자 두 번째 도움은 거부합니다.","refs":[{"book":10,"line":2,"label":"떠 있는 섬의 아이올로스"}]},
    {"id":"p-scylla","nameGreek":"Σκύλλη","nameKo":"스퀼라","role":"여섯 머리의 바다 괴물","summary":"해협 절벽 동굴에서 여섯 머리로 배 위의 선원 여섯을 낚아챕니다. 키르케는 맞서 싸울 수 없는 재앙으로 설명합니다.","refs":[{"book":12,"line":85,"label":"동굴 속 스퀼라"}]},
    {"id":"p-charybdis","nameGreek":"Χάρυβδις","nameKo":"카륍디스","role":"바닷물을 삼키는 괴물","summary":"하루 세 번 바닷물을 삼키고 토해내는 소용돌이의 괴물입니다. 오디세우스는 스퀼라와 카륍디스 사이에서 손실을 선택해야 합니다.","refs":[{"book":12,"line":104,"label":"검은 바닷물을 빨아들임"}]},
    {"id":"p-antinous","nameGreek":"Ἀντίνοος","nameKo":"안티노오스","role":"구혼자들의 주도자","summary":"텔레마코스 암살을 추진하고 집 안의 폭력을 주도합니다. 오디세우스가 정체를 드러낸 뒤 첫 화살로 죽인 인물입니다.","refs":[{"book":1,"line":383,"label":"텔레마코스에게 맞서 말함"},{"book":22,"line":8,"label":"첫 화살을 맞음"}]},
    {"id":"p-eurymachus","nameGreek":"Εὐρύμαχος","nameKo":"에우뤼마코스","role":"유력한 구혼자","summary":"말솜씨와 위장된 호의로 페넬로페와 텔레마코스를 속입니다. 안티노오스에게 모든 책임을 돌리며 배상을 제안하지만 거절당합니다.","refs":[{"book":1,"line":399,"label":"구혼자들의 계획을 감춤"},{"book":22,"line":45,"label":"안티노오스에게 책임을 돌림"}]},
    {"id":"p-mentor","nameGreek":"Μέντωρ","nameKo":"멘토르","role":"오디세우스의 동료·대리인","summary":"출정할 때 집을 맡은 오랜 동료입니다. 아테나가 그의 모습을 자주 빌리면서 후대에 ‘조언자’의 보통명사로 이어졌습니다.","refs":[{"book":2,"line":243,"label":"이타케 회의에서 구혼자 편의 공격을 받음"}]},
    {"id":"p-nestor","nameGreek":"Νέστωρ","nameKo":"네스토르","role":"퓔로스의 늙은 왕","summary":"트로이아 전쟁 세대의 기억과 조언을 대표합니다. 텔레마코스를 환대하고 아가멤논 가문의 귀환사를 들려줍니다.","refs":[{"book":1,"line":284,"label":"텔레마코스가 찾아갈 첫 왕"}]},
    {"id":"p-menelaus","nameGreek":"Μενέλαος","nameKo":"메넬라오스","role":"스파르테의 왕","summary":"헬레네의 남편이자 트로이아 원정의 지도자입니다. 긴 표류 끝에 돌아왔고 텔레마코스에게 오디세우스가 살아 있다는 소식을 줍니다.","refs":[{"book":1,"line":285,"label":"텔레마코스가 찾아갈 스파르테의 왕"}]},
    {"id":"p-helen","nameGreek":"Ἑλένη","nameKo":"헬레네","role":"메넬라오스의 아내","summary":"트로이아 전쟁의 원인이 된 인물로, 스파르테에서 약과 이야기로 손님들의 슬픔을 다룹니다. 자기 행동을 미망과 신의 작용 속에서 회고합니다.","refs":[{"book":4,"line":12,"label":"스파르테 왕가의 혼인 장면에서 언급됨"},{"book":4,"line":121,"label":"큰방에 들어옴"}]},
    {"id":"p-agamemnon","nameGreek":"Ἀγαμέμνων","nameKo":"아가멤논","role":"아카이오이 원정군의 왕","summary":"트로이아에서 귀환한 뒤 아이기스토스와 아내 클뤼타임네스트라에게 살해됩니다. 그의 실패한 귀환은 오디세우스의 귀환을 비추는 경고가 됩니다.","refs":[{"book":3,"line":143,"label":"귀환 때의 불화가 서술됨"},{"book":11,"line":405,"label":"저승에서 자기 죽음을 말함"}]},
    {"id":"p-achilles","nameGreek":"Ἀχιλλεύς","nameKo":"아킬레우스","role":"아카이오이 최고의 전사","summary":"트로이아에서 죽어 영원한 명성을 얻었지만, 저승에서는 죽은 자의 왕보다 살아 있는 품팔이꾼이 낫다고 말합니다.","refs":[{"book":3,"line":106,"label":"트로이아 전투를 회상하며 언급됨"},{"book":11,"line":488,"label":"죽음과 삶을 비교함"}]},
    {"id":"p-phemius","nameGreek":"Φήμιος","nameKo":"페미오스","role":"이타케 왕궁의 가객","summary":"구혼자들 앞에서 강제로 노래합니다. 구혼자 살해 뒤 자기 노래는 신에게서 온 것이라고 탄원해 목숨을 건집니다.","refs":[{"book":1,"line":337,"label":"페넬로페가 노래를 멈추라 청함"},{"book":22,"line":330,"label":"오디세우스에게 탄원함"}]},
    {"id":"p-melanthius","nameGreek":"Μελάνθιος","nameKo":"멜란티오스","role":"오디세우스의 염소치기·노예","summary":"변장한 주인을 모욕하고 구혼자들에게 무구를 나릅니다. 붙잡혀 고문당한 뒤 살육 후 신체 절단으로 처형됩니다.","refs":[{"book":17,"line":247,"label":"오디세우스와 에우마이오스를 모욕함"},{"book":22,"line":474,"label":"처형됨"}]}
  ]
}
